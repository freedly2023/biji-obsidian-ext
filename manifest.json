{
  "manifest_version": 3,
  "name": "GET笔记超级助手",
  "version": "1.0.0",
  "description": "订阅更新、视频播客一键提交转录、批量下载导出，支持 Obsidian",
  "permissions": ["storage", "cookies", "alarms"],
  "host_permissions": [
    "https://biji.com/*",
    "https://*.biji.com/*",
    "https://get-notes.luojilab.com/*",
    "https://*.luojilab.com/*",
    "https://*.umiwi.com/*",
    "https://www.youtube.com/*",
    "https://www.bilibili.com/*",
    "https://www.xiaoyuzhoufm.com/*"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://biji.com/*", "https://*.biji.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/*",
        "https://www.xiaoyuzhoufm.com/episode/*",
        "https://www.xiaoyuzhoufm.com/podcast/*"
      ],
      "js": ["content-inject-btn.js"],
      "css": ["inject-btn.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://biji.com/*", "https://*.biji.com/*"]
    }
  ]
}
